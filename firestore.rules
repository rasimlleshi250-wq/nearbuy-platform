rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isBusiness() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'business'];
    }

    // ── Users ─────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Categories ────────────────────────────────
    match /categories/{id} {
      allow read: if true;           // publik
      allow write: if isAdmin();     // vetëm admin
    }

    // ── Products ──────────────────────────────────
    match /products/{id} {
      allow read: if true;           // publik
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Businesses ────────────────────────────────
    match /businesses/{id} {
      allow read: if true;           // publik
      allow create: if isAuth();
      allow update: if isAdmin() ||
        (isAuth() && resource.data.ownerUID == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Business Products ─────────────────────────
    match /business_products/{id} {
      allow read: if true;           // publik
      allow create: if isBusiness();
      allow update: if isAdmin() ||
        (isAuth() && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerUID == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuth() && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerUID == request.auth.uid);
    }

    // ── Professionals ─────────────────────────────
    match /professionals/{id} {
      allow read: if true;           // publik
      allow create: if isAuth();
      allow update: if isAdmin() ||
        (isAuth() && resource.data.ownerUID == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
